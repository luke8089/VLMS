# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Environment variables
.env

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# OS files
Thumbs.db
.DS_Store

# Uploads (user-generated content — stored locally only)
uploads/courses/*/
uploads/profiles/*
!uploads/courses/.gitkeep
!uploads/profiles/.gitkeep

# Proctoring data (generated at runtime — stored locally only)
screenshots/*
!screenshots/.gitkeep
recordings/*
!recordings/.gitkeep

# AI models (large files)
ai_models/

# Distribution
dist/
build/
*.egg-info/

# Logs
*.log

# Database
*.db
*.sqlite3
